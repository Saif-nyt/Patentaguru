# MongoDB Atlas Connection (REQUIRED - never commit the real value)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/patente_bangla?retryWrites=true&w=majority
MONGODB_DB_NAME=patente_bangla

# Admin panel login (REQUIRED for the admin CRM)
# Use a long random password. Admin emails can be overridden with ADMIN_EMAILS.
ADMIN_PASSWORD=change_me_to_a_long_random_password
# ADMIN_EMAILS=khshifat@gmail.com,khshifatmanjum@gmail.com,saifulislamnyt@gmail.com

# Stripe payments (REQUIRED for checkout / VIP unlock)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Minimum accepted checkout price in EUR (guards against misconfigured prices)
# MIN_CHECKOUT_EUR=1

# Gemini AI tutor (optional - chatbot disabled without it)
GEMINI_API_KEY=your_gemini_api_key

# Exam policy
# FREE_MOCK_EXAMS=1

# Allowed browser origins for CORS (comma separated)
# SITE_ORIGINS=https://www.patenteguru.it,https://patenteguru.it

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_generated_secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Resend delivers email-verification links (required when requireEmailVerification is on)
RESEND_API_KEY=re_xxxxxxxx
# Sender address. MUST use a domain verified at resend.com/domains, otherwise
# Resend only delivers to the account's own email and rejects everyone else.
EMAIL_FROM=PatenteBangla <no-reply@yourdomain.com>

# Firebase remains in use for Firestore app settings/admin data and Analytics,
# but not for student sign-in or registration.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
